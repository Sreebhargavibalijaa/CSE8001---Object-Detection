# MOT17 dataset and all generated outputs (annotated frames, CSVs, MOT results, videos)
MOT17/
eval_slices/MOT17_development/
eval_slices/MOT17_test/

# Model weights -- ultralytics re-downloads these on first run
*.pt
*.onnx
*.pth

# Registry binaries (catalog.json is tracked)
**/registry/artifacts/
**/registry/export/

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.DS_Store
**/results/benchmark.log
docs/.mpl/
docs/profile/run.log

# Profiling leftovers: backups of superseded CSVs and logs of interrupted runs
docs/profile/*.bak
docs/profile/run_k8s_*.log
!docs/profile/run_k8s_20261116_031817.log

# Hand-off archives used to copy files between laptop and VM
*.tar.gz
*.tgz
vm_results/
